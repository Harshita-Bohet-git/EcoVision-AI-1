# EcoVision AI — Environment Variables
# Copy this file to .env and fill in your values
# Secrets (API keys, URIs) should be added via Replit Secrets, not committed to .env

# MongoDB connection string (required for database features)
# Add this as a Replit Secret named MONGODB_URI
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecovision?retryWrites=true&w=majority

# Node environment (development | production)
NODE_ENV=development
